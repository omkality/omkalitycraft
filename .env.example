# Native API: uv run python -m api. Environment overrides .env, then defaults.
API_HOST=127.0.0.1
API_PORT=8000
WORKERS_NUM=1
API_REQUESTS_PER_SECOND=128
CLIENT_REPORTS_PRUNE_INTERVAL_SECONDS=3600
CONTENT_ROOT=data/content

# Development Compose publishes only to loopback. Inside it API_HOST=0.0.0.0
# and CONTENT_ROOT=/data/content are fixed networking/mount paths.
# Granian multi-worker networking requires Linux >=5.14; Compose sets
# net.ipv4.tcp_migrate_req=1 only in the container's network namespace.
OMK_API_CONTENT_SOURCE=./data/content
OMK_API_CPUS=1.0
OMK_API_MEMORY_MIB=1024
OMK_API_LOG_MIB=10
OMK_API_LOG_FILES=3

# Optional API features. Keep private reports outside CONTENT_ROOT; the CDN-only
# development Compose does not enable/mount the private inbox.
# CLIENT_REPORTS_ROOT=.omk-admin/client-reports
# CLIENT_REPORTS_AUTH_URL=https://auth.example.invalid
SERVER_STATUS_CACHE_SECONDS=15
SERVER_STATUS_TIMEOUT_SECONDS=2
SERVER_STATUS_TARGETS={}

# Optional local `omk release pack` file retention; process environment only.
# The release CLI does not load .env automatically: uv run --env-file <file> omk ...
# OMK_RELEASE_SNAPSHOT_ROOT=.omk-admin/client-releases
# OMK_RELEASE_SNAPSHOT_MAX_BYTES=34359738368
# OMK_RELEASE_SNAPSHOT_RESERVE_BYTES=1073741824
# OMK_RELEASE_SNAPSHOT_MAX_COUNT=64
