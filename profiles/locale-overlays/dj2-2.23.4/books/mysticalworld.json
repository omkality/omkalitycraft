    },
    {
      "source_file": "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/creatures/clam.json",
      "pointer": "/pages/1/text",
      "source_sha256": "0c4abcf0e4c4c9e2acc5f7594138ae20a1e6e7a167c31a6bf75be55a7dabc96b",
      "ru": "Зрелые моллюски испускают частицы. При убийстве из них выпадает $(l:items/pearl)жемчужина$(), а из особых моллюсков, возможно, даже жемчуг Эндера!",
      "decision": "reviewed_translation",
      "consumer_contract": "Patchouli_text"
    },
    {
      "source_file": "assets/mysticalworld/patchouli_books/world_guide/en_us/entries/cuisine/salads.json",
