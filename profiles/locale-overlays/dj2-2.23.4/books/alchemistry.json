    {
      "source_file": "assets/alchemistry/patchouli_books/alchemistry_book/en_us/entries/compounds/spiking_food.json",
      "pointer": "/pages/0/text",
      "source_sha256": "e8e4526b1249903cbae065d64d60bed318d7693d6d8c2978851ccf39411d692c",
      "ru": "К обычной еде можно подмешать активное соединение: достаточно объединить по одному предмету каждого вида в сетке крафта. Съев такую еду, игрок получит эффекты добавленного соединения.",
      "decision": "reviewed_translation",
      "consumer_contract": "Patchouli_text"
    },
    {
      "source_file": "assets/alchemistry/patchouli_books/alchemistry_book/en_us/entries/compounds/spiking_food.json",
