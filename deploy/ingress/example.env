# Use the same process environment for prepare, Compose and the first owner plan.
# CLI does not load this file automatically: uv run --env-file <file> omk ...
# Set these required identities from your private ingress.toml/preparation result:
# OMK_INGRESS_CONTAINER=<explicit-owned-container>
# OMK_INGRESS_OWNER=<explicit-fresh-owner>
# OMK_INGRESS_CONTROL_VOLUME=<fresh-private-control-volume>
# OMK_INGRESS_CONTROL_OWNER=<explicit-fresh-control-owner>
# OMK_INGRESS_CONFIG_DIR=<absolute-prepared-config-directory>
# OMK_INGRESS_NETWORK=<existing-owned-private-bridge>

# Must match the explicit private ingress.toml ports.
OMK_INGRESS_HOST_PORT=25580
OMK_INGRESS_CONTAINER_PORT=25565
OMK_INGRESS_CPUS=0.5
OMK_INGRESS_MEMORY_MIB=64
OMK_INGRESS_PIDS=64
OMK_INGRESS_MAX_CONNECTIONS=128
OMK_INGRESS_CONNECT_SECONDS=5
OMK_INGRESS_IDLE_SECONDS=3600
OMK_INGRESS_TIMEOUT_SECONDS=30
OMK_INGRESS_DOCKER_LOG_MIB=10
OMK_INGRESS_DOCKER_LOG_FILES=3
