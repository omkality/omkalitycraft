# Owner-only saved-statistics query. Set in the operator process environment.
# The CLI does not auto-load this file. No game counter or collector is configured.
OMK_PLAYTIME_INPUT_MIB=4
OMK_PLAYTIME_TIMEOUT_SECONDS=30
# Helper CPU/RAM reuse OMK_BACKUP_HELPER_CPUS / OMK_BACKUP_HELPER_MEMORY_MIB
# documented in docs/COLD_BACKUPS.md; the game volume is always read-only.
