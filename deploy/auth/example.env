# Template only. Choose an explicit absolute private config path before Compose.
# The configure CLI reads process environment, not this file automatically:
# uv run --env-file deploy/auth/example.env omk auth configure --output <new-file>
# docker compose --env-file deploy/auth/example.env -f deploy/auth/compose.yaml config
# OMK_AUTH_CONFIG=/absolute/private/path/drasl.toml

OMK_AUTH_URL=http://127.0.0.1:25586
OMK_AUTH_ADMIN=omk_owner
OMK_AUTH_HTTP_PORT=25586
OMK_AUTH_INTERNAL_PORT=25585
OMK_AUTH_TOKEN_EXPIRE_SECONDS=2592000
OMK_AUTH_TOKEN_STALE_SECONDS=86400
OMK_AUTH_MIN_PASSWORD_LENGTH=8

# Compose resource limits; these are not written into drasl.toml.
OMK_AUTH_CPUS=1.0
OMK_AUTH_MEMORY=384m
OMK_AUTH_PIDS=128
OMK_AUTH_GO_MEMORY=300MiB
OMK_AUTH_TMP_SIZE=32m
OMK_AUTH_LOG_SIZE=10m
OMK_AUTH_LOG_FILES=3
OMK_AUTH_STOP_TIMEOUT=20s
