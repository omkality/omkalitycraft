# Calendar defaults. Enabling this flag alone does not start a process or host job.
OMK_NIGHTLY_SCHEDULE_ENABLED=false
OMK_NIGHTLY_LOCAL_TIME=05:00
OMK_NIGHTLY_TIMEZONE=Europe/Moscow
OMK_NIGHTLY_WARNINGS_SECONDS=600,300,60,10
# Maximum lateness before an unattempted warning/close/stop is refused (1-60).
OMK_NIGHTLY_WARNING_GRACE_SECONDS=30
