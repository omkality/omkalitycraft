# Legacy Core JSON diagnostics only; not used by the standard monitoring deployment.
# Generic Core 1.12.2, opt-in. The game container writes only its metrics volume here.
OMK_GAME_METRICS_ENABLED=true
OMK_GAME_METRICS_INTERVAL_SECONDS=30
OMK_GAME_METRICS_TPS_WINDOW_SECONDS=60
OMK_GAME_METRICS_MAX_DIMENSIONS=32
OMK_GAME_METRICS_DIRECTORY=/run/omk-metrics
# Collector overlay selects the same volume, never the whole game/auth volume.
OMK_DJ2_METRICS_VOLUME=omk-dj2-metrics
