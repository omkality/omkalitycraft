# Private owner configuration; do not commit the populated file.
OMK_METRICS_CONFIG=/opt/omk/.omk-admin/metrics.json
OMK_METRICS_GAME_NETWORK=omk-game
OMK_METRICS_PORT=9090
OMK_METRICS_INTERVAL_SECONDS=30
OMK_METRICS_RETENTION_DAYS=180
OMK_METRICS_RETENTION_MIB=1024
OMK_METRICS_PROM_CPUS=0.25
OMK_METRICS_PROM_MEMORY_MIB=256
OMK_METRICS_AGENT_CPUS=0.25
OMK_METRICS_AGENT_MEMORY_MIB=128
OMK_METRICS_CONFIG_CPUS=0.25
OMK_METRICS_CONFIG_MEMORY_MIB=64
OMK_METRICS_PIDS=64
OMK_METRICS_QUERY_CONCURRENCY=4
OMK_METRICS_QUERY_SAMPLES=1000000
OMK_METRICS_QUERY_TIMEOUT_SECONDS=15
OMK_METRICS_HEALTH_SECONDS=30
OMK_METRICS_LOG_MIB=1
OMK_METRICS_LOG_FILES=2
OMK_METRICS_RESTART=unless-stopped
OMK_METRICS_HOST_PROC=/proc
OMK_METRICS_HOST_SYS=/sys
OMK_METRICS_HOST_CGROUP=/sys/fs/cgroup
