# Explicit opt-in deployment only after the owner's repository audit.
OMK_METRICS_INTERVAL_SECONDS=30
OMK_METRICS_DATABASE_MIB=64
OMK_METRICS_DETAIL_DAYS=7
OMK_METRICS_HOURLY_DAYS=180
# This is additional to a full rollback journal. Use the PROJECT free reserve on VPS.
OMK_METRICS_RESERVE_MIB=24576
OMK_METRICS_CPUS=0.25
OMK_METRICS_MEMORY_MIB=96
OMK_METRICS_PIDS=32
OMK_METRICS_STOP_SECONDS=10
OMK_METRICS_HEALTH_SECONDS=30
OMK_METRICS_RESTART=unless-stopped
OMK_METRICS_LOG_MIB=1
OMK_METRICS_LOG_FILES=2
# Absolute paths on the Linux Docker HOST, not the Windows desktop.
OMK_METRICS_CONFIG=/opt/omk/.omk-admin/metrics.json
OMK_METRICS_PROJECT=/opt/omk
OMK_METRICS_HOST_PROC=/proc
OMK_METRICS_HOST_CGROUP=/sys/fs/cgroup
