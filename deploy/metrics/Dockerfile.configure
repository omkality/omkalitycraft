FROM python:3.14.2-slim@sha256:1a3c6dbfd2173971abba880c3cc2ec4643690901f6ad6742d0827bae6cefc925
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY omk/__init__.py omk/monitoring_config.py ./omk/
RUN mkdir -p /etc/omk-metrics && chown 10001:10001 /etc/omk-metrics
USER 10001:10001
ENTRYPOINT ["python", "-m", "omk.monitoring_config"]
