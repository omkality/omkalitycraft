# XML generation for the reviewed Forge 1.12.2 Log4j adapter, before launch/staging.
# Export in the generator/launcher process; no automatic .env loading or live reload.
OMK_FORGE_LOG_MIB=8
OMK_FORGE_LOG_FILES=3

# Environment of the dedicated-server JVM running DJ2Fix 0.1.9 or later.
OMK_GROOVY_LOG_MIB=8
OMK_GROOVY_LOG_FILES=3
