# Owner candidate plan/apply environment; separate from the TOML slot identities.
# A plan freezes these settings. Changing them requires a new plan.
OMK_SLOT_MEMORY_MIB=8192
OMK_SLOT_HEAP_MIB=6144
OMK_SLOT_INITIAL_HEAP_MIB=1024
OMK_SLOT_CPUS=4
OMK_SLOT_PIDS=512
# Maximum owner readback/export bytes, not the Docker logging driver threshold.
OMK_SLOT_LOG_BYTES=4194304
OMK_SLOT_DOCKER_LOG_MIB=10
OMK_SLOT_DOCKER_LOG_FILES=3
