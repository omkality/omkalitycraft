@@ -0,0 +1,56 @@
+package main
+
+import (
+	"bytes"
+	"github.com/labstack/echo/v5"
+	"gorm.io/gorm"
+	"io"
+	"net/http"
+	"strings"
+)
+
+// One active Drasl process owns this SQLite state. Serialize complete security
+// requests (including Bind authentication), so a request authenticated before
+// reset cannot save old User/Client/Player fields after it. Immutable texture
+// and frontend files stay parallel, including self-hosted texture downloads.
+func (app *App) serializeSecurityRequests() echo.MiddlewareFunc {
+	return func(next echo.HandlerFunc) echo.HandlerFunc {
+		return func(c *echo.Context) error {
+			req := c.Request()
+			read := req.Method == http.MethodGet || req.Method == http.MethodHead
+			route := c.Path()
+			static := strings.HasSuffix(route, "*") && (strings.Contains(route, "/textures/texture/") || strings.HasSuffix(route, "/web/public*"))
+			if read && static {
+				return next(c)
+			}
+			// Slow uploads must not hold the security lock. Bound the buffered body.
+			if req.Body != nil && req.Body != http.NoBody {
+				const limit = 4 * 1024 * 1024
+				data, err := io.ReadAll(io.LimitReader(req.Body, limit+1))
+				req.Body.Close()
+				if err != nil {
+					return err
+				}
+				if len(data) > limit {
+					return NewUserErrorWithCode(http.StatusRequestEntityTooLarge, Tr("Request body too large."))
+				}
+				req.Body = io.NopCloser(bytes.NewReader(data))
+			}
+			app.SecurityMutex.Lock()
+			defer app.SecurityMutex.Unlock()
+			return next(c)
+		}
+	}
+}
+
+// Touch only usage metadata; never save a stale Client version over revocation.
+func recordClientUse(db *gorm.DB, client *Client) error {
+	result := db.Model(&Client{}).Where("uuid = ? AND version = ?", client.UUID, client.Version).Update("last_used_at", client.LastUsedAt)
+	if result.Error != nil {
+		return result.Error
+	}
+	if result.RowsAffected != 1 {
+		return NewUserError(Tr("client authorization changed"))
+	}
+	return nil
+}
